    },
    {
      "label": "Volumes",
      "value": "1"
    }
  ],
  "notes": [
    {
      "text": "nginx terminates client traffic and load-balances the API pool",
      "at": "nginx"
    },
    {
      "text": "The worker consumes the queue and writes results back to Postgres",
      "at": "worker"
    }
  ]
}
